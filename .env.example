# What the APPLICATION reads. Local development points at a SQLite file, so the
# admin panel — which deletes games and blob files — can never reach production.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# What the MIGRATION TOOLING reads, and nothing else: `npm run db:migrate:staging`,
# `db:migrate:production` and `db:stamp -- --target=...`. Filling these in does not
# give the running app any route to those databases, so applying a migration to
# production no longer means editing the variables above.
# See .claude/docs/schema-migrations.md
TURSO_STAGING_DATABASE_URL=libsql://your-staging-db.turso.io
TURSO_STAGING_AUTH_TOKEN=your-staging-token
TURSO_PRODUCTION_DATABASE_URL=libsql://your-production-db.turso.io
TURSO_PRODUCTION_AUTH_TOKEN=your-production-token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token

# Admin panel (/admin) — without it the admin area cannot be logged into.
# The password doubles as the session signing key: changing it logs everyone out.
ADMIN_PASSWORD=choose-a-long-random-password

# Optional: enables the "Import from RAWG" screenshot picker in the admin panel.
# Free key at https://rawg.io/apidocs
RAWG_API_KEY=your-rawg-key
